TEAM_ID=

PRODUCT_NAME=MyMonsterBruno
PRODUCT_BUNDLE_IDENTIFIER=com.fanguskdev.mymonsterbruno.MyMonsterBruno

CURRENT_PROJECT_VERSION=1
